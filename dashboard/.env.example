# Job Processing Dashboard Environment Variables

# Backend API Configuration
VITE_API_BASE_URL=http://localhost:8888/api

# Development Settings
VITE_DEBUG_MODE=false
VITE_AUTO_REFRESH_INTERVAL=5000

# Analytics Settings
VITE_ANALYTICS_ENABLED=true
VITE_ERROR_REPORTING=true

# Feature Flags
VITE_ENABLE_DEAD_LETTER_RETRY=true
VITE_ENABLE_JOB_DELETE=false
VITE_ENABLE_WORKER_SCALING=false

# Theming
VITE_THEME_MODE=light
VITE_PRIMARY_COLOR=#000000
